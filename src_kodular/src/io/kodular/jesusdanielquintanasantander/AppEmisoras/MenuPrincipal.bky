<xml xmlns="https://developers.google.com/blockly/xml">
<block type="component_event" x="0" y="0">
  <mutation component_type="Form" is_generic="false" instance_name="MenuPrincipal" event_name="Initialize"></mutation>
  <field name="COMPONENT_SELECTOR">MenuPrincipal</field>
  <statement name="DO">
    <block type="controls_if">
      <mutation elseif="0" else="0"></mutation>
      <value name="IF0">
        <block type="text_isEmpty">
          <value name="VALUE">
            <block type="component_method">
              <mutation component_type="TinyDB" method_name="GetValue" is_generic="false" instance_name="TinyDB1"></mutation>
              <field name="COMPONENT_SELECTOR">TinyDB1</field>
              <value name="ARG0"><block type="text"><field name="TEXT">usuarioId</field></block></value>
              <value name="ARG1"><block type="text"><field name="TEXT"></field></block></value>
            </block>
          </value>
        </block>
      </value>
      <statement name="DO0">
        <block type="controls_openAnotherScreen">
          <mutation></mutation>
          <value name="SCREEN"><block type="text"><field name="TEXT">Screen1</field></block></value>
        </block>
      </statement>
    </block>
  </statement>
</block>
<block type="component_event" x="0" y="200">
  <mutation component_type="Button" is_generic="false" instance_name="BotonEmisoras" event_name="Click"></mutation>
  <field name="COMPONENT_SELECTOR">BotonEmisoras</field>
  <statement name="DO">
    <block type="controls_openAnotherScreen">
      <mutation></mutation>
      <value name="SCREEN"><block type="text"><field name="TEXT">EmisorasLista</field></block></value>
    </block>
  </statement>
</block>
