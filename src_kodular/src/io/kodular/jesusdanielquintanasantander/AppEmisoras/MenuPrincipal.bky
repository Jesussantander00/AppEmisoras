  <mutation component_type="Button" is_generic="false" instance_name="BotonProgramas" event_name="Click"></mutation>
  <field name="COMPONENT_SELECTOR">BotonProgramas</field>
  <statement name="DO">
    <block type="controls_openAnotherScreen">
      <mutation></mutation>
      <value name="SCREEN"><block type="text"><field name="TEXT">ProgramasLista</field></block></value>
    </block>
  </statement>
</block>
<block type="component_event" x="0" y="600">
  <mutation component_type="Button" is_generic="false" instance_name="BotonReporteEmisoras" event_name="Click"></mutation>
  <field name="COMPONENT_SELECTOR">BotonReporteEmisoras</field>
  <statement name="DO">
    <block type="controls_openAnotherScreen">
      <mutation></mutation>
      <value name="SCREEN"><block type="text"><field name="TEXT">ReporteEmisoras</field></block></value>
    </block>
  </statement>
</block>
<block type="component_event" x="0" y="800">
  <mutation component_type="Button" is_generic="false" instance_name="BotonReporteProgramas" event_name="Click"></mutation>
  <field name="COMPONENT_SELECTOR">BotonReporteProgramas</field>
  <statement name="DO">
    <block type="controls_openAnotherScreen">
      <mutation></mutation>
      <value name="SCREEN"><block type="text"><field name="TEXT">ReporteProgramas</field></block></value>
    </block>
  </statement>
</block>
<block type="component_event" x="0" y="1000">
  <mutation component_type="Button" is_generic="false" instance_name="BotonCerrarSesion" event_name="Click"></mutation>
  <field name="COMPONENT_SELECTOR">BotonCerrarSesion</field>
  <statement name="DO">
    <block type="component_method">
      <mutation component_type="TinyDB" method_name="StoreValue" is_generic="false" instance_name="TinyDB1"></mutation>
      <field name="COMPONENT_SELECTOR">TinyDB1</field>
      <value name="ARG0"><block type="text"><field name="TEXT">usuarioId</field></block></value>
      <value name="ARG1"><block type="text"><field name="TEXT"></field></block></value>
      <next>
        <block type="controls_openAnotherScreen">
          <mutation></mutation>
          <value name="SCREEN"><block type="text"><field name="TEXT">Screen1</field></block></value>
        </block>
      </next>
    </block>
  </statement>
</block>
</xml>
